MONGO_URL=mongodb://localhost:27017
DB_NAME=jaisarvalaya
# FIX: Changed from wildcard "*" to an explicit origin.
# FastAPI/Starlette raises a ValueError if allow_credentials=True is combined
# with allow_origins=["*"]. Use a comma-separated list of real origins here.
# For production, replace with your actual frontend URL, e.g.:
# CORS_ORIGINS=https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

